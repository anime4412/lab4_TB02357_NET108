@model IEnumerable<QuanLyThuVien.Models.Category>

@{
    ViewData["Title"] = "Quản lý thể loại sách - Lab 4";
    bool isManager = User.IsInRole("Admin") || User.IsInRole("Manager");
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="text-primary mb-0"><i class="bi bi-tags"></i> Quản Lý Danh Mục Thể Loại Sách (Phần II - Bài 3)</h2>
            <p class="text-muted small mb-0">Đề tài: Quản Lý Thư Viện Điện Tử | Phân quyền: Policy <code>EmployeeOrManager</code> & <code>ManagerOnly</code></p>
        </div>
        @if (isManager)
        {
            <a asp-action="Create" class="btn btn-success shadow-sm">
                <i class="bi bi-plus-circle"></i> Thêm Thể Loại Mới (Chỉ Quản lý)
            </a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 70px;">ID</th>
                            <th style="width: 100px;">Hình ảnh</th>
                            <th>Tên thể loại</th>
                            <th>Mô tả thể loại</th>
                            <th style="width: 120px;" class="text-center">Trạng thái</th>
                            <th style="width: 220px;" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><strong>#@item.Id</strong></td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.Image))
                                        {
                                            <img src="@item.Image" alt="@item.Name" class="rounded" style="width: 50px; height: 50px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border">No image</span>
                                        }
                                    </td>
                                    <td class="fw-bold text-dark">@item.Name</td>
                                    <td class="text-muted">@item.Description</td>
                                    <td class="text-center">
                                        @if (item.Active)
                                        {
                                            <span class="badge bg-success">Đang dùng</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Tạm ngưng</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Chi tiết</a>
                                        @if (isManager)
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary ms-1">Sửa</a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger ms-1">Xóa</a>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-secondary ms-1" title="Chỉ Quản lý mới được sửa/xóa">Chỉ đọc</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    Chưa có thể loại nào trong CSDL.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
